        }
        .card {
            background-color: var(--card-bg);
            padding: 25px;
            border-radius: 12px;
            border: 1px solid #334155;
        }
        .card h3 {
            color: var(--accent-color);
            margin-top: 0;
        }
        footer {
            text-align: center;
            padding: 30px;
            color: #64748b;
